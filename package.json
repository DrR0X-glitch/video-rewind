{
  "name": "dvd-store-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:init": "node --env-file=.env.local scripts/init-db.mjs",
    "backfill:imdb": "node --env-file=.env.local scripts/backfill-imdb.mjs",
    "backfill:collections": "node --env-file=.env.local scripts/backfill-collections.mjs",
    "import:stock": "node --env-file=.env.local scripts/import-stock-csv.mjs",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down"
  },
  "dependencies": {
    "next": "16.2.2",
    "pg": "^8.20.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
