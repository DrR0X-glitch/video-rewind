{
  "name": "dvd-store-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:init": "node --env-file=.env.local scripts/init-db.mjs",
    "db:seed:dev": "node --env-file=.env.local scripts/seed-dev-db.mjs",
    "backfill:imdb": "node --env-file=.env.local scripts/backfill-imdb.mjs",
    "backfill:collections": "node --env-file=.env.local scripts/backfill-collections.mjs",
    "import:stock": "node --env-file=.env.local scripts/import-stock-csv.mjs",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down"
  },
  "dependencies": {
    "next": "16.2.10",
    "pg": "^8.22.0",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19",
    "eslint": "^10.7.0",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^5"
  }
}
